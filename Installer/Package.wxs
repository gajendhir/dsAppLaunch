<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Data Spec Application Launcher"
           Manufacturer="Data Spec"
           Version="2.4.0"
           UpgradeCode="BFDF6AF8-8582-47E3-963D-F76EC795412F"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of dsAppLaunch is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(sys.SOURCEFILEDIR)..\dsAppLaunch.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.dataspec.info" />

    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)Banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)Dialog.bmp" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Data Spec Application Launcher" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="Data Spec" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**">
        <Exclude Files="$(PublishDir)\**\*.pdb" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="ShortcutComponents" Directory="AppProgramMenuFolder">
      <Component Id="ApplicationShortcut" Guid="{9C445E4C-5CB2-4D54-871D-ACB8B03EB921}">
        <Shortcut Id="StartMenuShortcut"
                  Name="Data Spec Application Launcher"
                  Description="Launch your applications from one place"
                  Target="[INSTALLFOLDER]dsAppLaunch.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="RemoveAppProgramMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Data Spec\dsAppLaunch" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DesktopShortcutComponents" Directory="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{EA60F0DD-4261-4B79-B087-F3488D56AF09}">
        <Shortcut Id="DesktopShortcut"
                  Name="Data Spec Application Launcher"
                  Description="Launch your applications from one place"
                  Target="[INSTALLFOLDER]dsAppLaunch.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\Data Spec\dsAppLaunch" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="dsAppLaunch" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="ShortcutComponents" />
      <ComponentGroupRef Id="DesktopShortcutComponents" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>
</Wix>
